# Google OAuth "Web application" client (Google Cloud Console -> Credentials).
# Authorized redirect URI must be exactly:
#   https://<your-deployed-domain>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Custom URI scheme/host the Flet Android/iOS app registers as a deep link.
# Must match [tool.flet.<platform>.deep_linking] in diezmapp/pyproject.toml.
APP_REDIRECT_SCHEME=com.diezapp.diezapp
APP_REDIRECT_HOST=oauth2redirect

# Optional: required in the `X-App-Secret` header on POST /api/auth/refresh.
# Defense in depth only (the endpoint already requires a valid refresh_token).
APP_SHARED_SECRET=

# Optional: override the origin used to build redirect_uri (defaults to the
# incoming request's detected origin). Set this if the detected origin can
# differ from the domain registered in Google Cloud Console (e.g. behind a
# proxy, or multiple preview/production domains on Vercel).
PUBLIC_APP_URL=

# Comma-separated HTTPS origins allowed as Flet web OAuth return targets.
# Local http://localhost and http://127.0.0.1 origins are allowed automatically.
WEB_APP_ORIGINS=
